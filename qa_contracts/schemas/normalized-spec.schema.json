{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qa-platform/contracts/normalized-spec/1.0",
  "title": "Normalized Spec (Contract 1)",
  "description": "Output of the Spec Normalizer, input to the Test-Case Designer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticket_id", "source", "acceptance_criteria"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "ticket_id": { "type": "string", "minLength": 1 },
    "source": { "enum": ["confluence", "clickup", "jira", "file", "text"] },
    "title": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["greenfield", "brownfield"] },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenarios"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "feature": { "type": "string" },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "given", "when", "then"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["positive", "negative", "boundary"] },
                "given": { "type": "array", "items": { "type": "string" } },
                "when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "then": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "test_data": {
      "type": "object",
      "description": "Optional concrete data the spec provides (e.g. credentials), so generated tests use real values instead of placeholders. Each value is a string or a string-to-string object.",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "object", "additionalProperties": { "type": "string" } }
        ]
      }
    },
    "setup": {
      "type": "array",
      "description": "Optional data provisioning to run before the scenarios (seed/reset), declared by intent.",
      "items": { "$ref": "#/definitions/data_step" }
    },
    "teardown": {
      "type": "array",
      "description": "Optional cleanup to run after the scenarios, declared by intent.",
      "items": { "$ref": "#/definitions/data_step" }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "traceability": {
      "type": "object",
      "description": "Free-form provenance links, e.g. spec_url, parent.",
      "additionalProperties": { "type": "string" }
    }
  },
  "definitions": {
    "data_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["via", "description"],
      "properties": {
        "via": { "enum": ["api", "db", "ui"], "description": "Channel the step runs through." },
        "description": { "type": "string", "minLength": 1, "description": "Natural-language intent, for the model." },
        "data": {
          "type": "object",
          "description": "Declarative payload/params/SQL reference. No secrets: use env placeholders such as ${API_TOKEN} (as strings)."
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qa-platform/contracts/step/1.0",
  "title": "Step (reusable page-object method)",
  "description": "One reusable async method on a page object. Emitted by the Synthesizer in manifest.new, promoted by the Runner, stored and returned by the Step Library (/promote.step, /search[].step). An assertion step takes no params. `language` names the language of the body lines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "intent", "page_object", "language", "body"],
  "properties": {
    "kind": { "enum": ["action", "assertion"] },
    "language": { "enum": ["python", "typescript", "javascript"] },
    "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
    "intent": { "type": "string", "pattern": "\\S" },
    "page_object": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "params": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\S" }
    }
  },
  "if": { "properties": { "kind": { "const": "assertion" } }, "required": ["kind"] },
  "then": { "properties": { "params": { "maxItems": 0 } } }
}
